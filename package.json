{
  "name": "webapp",
  "type": "module",
  "version": "1.0.0",
  "description": "Sistema de Reserva de Citas para un Consultorio Médico (Hono + Cloudflare Pages + D1)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "dev:sandbox": "wrangler pages dev dist --local --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl -s http://localhost:3000/api/health",
    "seed:generar": "node scripts/generar-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply webapp-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply webapp-production --remote",
    "db:seed": "wrangler d1 execute webapp-production --local --file=./seed.sql",
    "db:seed:prod": "wrangler d1 execute webapp-production --remote --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:console:local": "wrangler d1 execute webapp-production --local",
    "db:console:prod": "wrangler d1 execute webapp-production --remote"
  },
  "dependencies": {
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}