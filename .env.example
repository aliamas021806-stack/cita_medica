# Plantilla de credenciales de despliegue (BYOK).
# Copia este archivo como .deploy.env, rellena el valor y cárgalo con:
#   set -a && . ./.deploy.env && set +a
# .deploy.env está en .gitignore y NUNCA debe subirse al repositorio.

# API Token de Cloudflare con permisos:
#   - Cloudflare Pages: Edit
#   - D1: Edit
CLOUDFLARE_API_TOKEN=

# Opcionales (los valores mostrados son los predeterminados)
# CF_PAGES_PROJECT=cita-medica-consultorio
# D1_DATABASE_NAME=webapp-production
# CF_PRODUCTION_BRANCH=main
